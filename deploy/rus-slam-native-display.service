[Unit]
Description=RUS SLAM: нативный основной экран на дисплее робота
Documentation=file:/opt/rus_slam/gui/README.md
After=graphical.target rus-slam-server.service
Wants=rus-slam-server.service
PartOf=graphical.target

[Service]
Type=simple
WorkingDirectory=/opt/rus_slam
ExecStart=/opt/rus_slam/gui/dist/RUS-SLAM-Display --url http://127.0.0.1:8080
Restart=always
RestartSec=3

# Пользователь графической сессии и дисплей — настройте под образ робота.
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rus/.Xauthority
User=rus

[Install]
WantedBy=graphical.target
