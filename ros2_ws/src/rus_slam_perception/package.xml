<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rus_slam_perception</name>
  <version>0.1.0</version>
  <description>Камера и детекция дорожной инфраструктуры: знаки «Стоп», «Пешеходный переход», «Искусственная неровность», светофоры</description>
  <maintainer email="team@rus-slam.local">RUS SLAM Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>rus_slam_interfaces</depend>

  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
